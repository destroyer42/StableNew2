{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/destroyer42/StableNew2/docs/schemas/stablenew.review-gateway-sync.v1.json",
  "title": "StableNew review gateway sync contract v1",
  "description": "Payloads exchanged between the StableNew PC sync worker (RG-120) and the review gateway (RG-110). The PC initiates every exchange. Items are identified by library id plus SHA-256 and never by path (RG-100 invariant 3). Outbox records are requests the PC validates, applies or refuses (invariant 4). A breaking change bumps schema_version.",
  "oneOf": [
    {
      "$ref": "#/$defs/item_manifest"
    },
    {
      "$ref": "#/$defs/outbox_page"
    },
    {
      "$ref": "#/$defs/acknowledgement"
    },
    {
      "$ref": "#/$defs/immich_receipt"
    },
    {
      "$ref": "#/$defs/device_revocation"
    },
    {
      "$ref": "#/$defs/pairing_offer"
    }
  ],
  "$defs": {
    "schema_version": {
      "const": "stablenew.review-gateway-sync.v1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "library_id": {
      "description": "Opaque, stable Output Library item id assigned by the PC. Never a path.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "run_id": {
      "description": "Output run folder name, used only for grouping.",
      "type": "string",
      "pattern": "^[0-9]{8}_[0-9]{6}_[A-Za-z0-9._ -]{1,96}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "item_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_id",
        "sha256"
      ],
      "properties": {
        "library_id": {
          "$ref": "#/$defs/library_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "media_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "content_type"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "content_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "video/mp4",
            "video/webm"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "item_manifest": {
      "description": "PC to gateway: one publishable item. Media bodies are uploaded separately and addressed by their sha256. Idempotent by (library_id, sha256).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "item",
        "kind",
        "run_id",
        "created_at",
        "media"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "item_manifest"
        },
        "item": {
          "$ref": "#/$defs/item_ref"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thumb_320",
            "original"
          ],
          "properties": {
            "thumb_320": {
              "$ref": "#/$defs/media_variant"
            },
            "preview_1080": {
              "$ref": "#/$defs/media_variant"
            },
            "mobile_video": {
              "$ref": "#/$defs/media_variant"
            },
            "original": {
              "$ref": "#/$defs/media_variant"
            }
          }
        },
        "display": {
          "description": "Display-only text, rendered as text on the phone (S7). Never used for decisions.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 200
            },
            "prompt_excerpt": {
              "type": "string",
              "maxLength": 512
            },
            "seed": {
              "type": "integer"
            },
            "job_id": {
              "type": "string",
              "maxLength": 64
            },
            "workflow": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "favorite"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "keep",
            "delete"
          ]
        },
        "favorite": {
          "type": "boolean",
          "description": "Only meaningful with keep; the PC refuses favorite with delete."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "face",
              "hands",
              "anatomy",
              "artifact",
              "prompt_miss",
              "needs_fix"
            ]
          }
        }
      }
    },
    "action_name": {
      "enum": [
        "fix_face",
        "fix_hands",
        "fix_both",
        "more_like_this",
        "another_model",
        "aspect_ratio",
        "prompt_tweak",
        "make_video",
        "rerun_clip",
        "continue_clip"
      ]
    },
    "action_request": {
      "description": "RG-140: a phone action, in two steps. 'prepare' asks the PC to compile exactly what it would queue and answer with an action_summary, admitting nothing; 'confirm' names that prepare record and the summary revision the phone showed, and the PC admits only when its fresh compile has the same revision. Validated again on the PC against its closed lists; slice 1 implements fix_face, fix_hands, fix_both and more_like_this.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "params"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action_name"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "enum": [
                "prepare",
                "confirm"
              ]
            },
            "count": {
              "description": "more_like_this only, on prepare: how many new seeds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "prepared_record": {
              "$ref": "#/$defs/uuid"
            },
            "summary_revision": {
              "$ref": "#/$defs/sha256"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "step": {
                    "const": "confirm"
                  }
                }
              },
              "then": {
                "required": [
                  "prepared_record",
                  "summary_revision"
                ],
                "not": {
                  "required": [
                    "count"
                  ]
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "prepared_record"
                      ]
                    },
                    {
                      "required": [
                        "summary_revision"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "not": {
                  "const": "more_like_this"
                }
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "not": {
                  "required": [
                    "count"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "action_warning": {
      "description": "One N1 policy warning as the PC shows it (S12): PC-authored text, scrubbed of paths, rendered as text only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "subject",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "subject": {
          "type": "string",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "why": {
          "type": "string",
          "maxLength": 800
        },
        "fix": {
          "type": "string",
          "maxLength": 800
        }
      }
    },
    "action_summary": {
      "description": "PC to gateway, inside an acknowledgement receipt: the one-screen summary of what an action would queue (RG-140). The phone shows it before Queue; 'revision' fingerprints everything shown plus the compiled recipe without ids and seeds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "revision",
        "title",
        "lines",
        "job_count",
        "queue_position",
        "warnings",
        "expires_at"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action_name"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lines": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "job_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "queue_position": {
          "enum": [
            "next",
            "last"
          ]
        },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/action_warning"
          }
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "outbox_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "idempotency_key",
        "device_id",
        "created_at",
        "target",
        "kind"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target": {
          "$ref": "#/$defs/item_ref"
        },
        "kind": {
          "enum": [
            "decision",
            "action_request"
          ]
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "action_request": {
          "$ref": "#/$defs/action_request"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            }
          },
          "then": {
            "required": [
              "decision"
            ],
            "not": {
              "required": [
                "action_request"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action_request"
              }
            }
          },
          "then": {
            "required": [
              "action_request"
            ],
            "not": {
              "required": [
                "decision"
              ]
            }
          }
        }
      ]
    },
    "outbox_page": {
      "description": "Gateway to PC, in reply to the PC's list request: pending records in creation order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "records"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "outbox_page"
        },
        "records": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/outbox_record"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "enrolled_devices": {
          "description": "Devices enrolled from pairing offers since the PC's last acknowledgement, so the desktop can list and revoke them.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device_id",
              "offer_id",
              "enrolled_at"
            ],
            "properties": {
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              "offer_id": {
                "$ref": "#/$defs/uuid"
              },
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "enrolled_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      }
    },
    "acknowledgement": {
      "description": "PC to gateway: the authoritative outcome of one outbox record. The gateway purges nothing before this arrives (S9).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "record_id",
        "outcome",
        "acknowledged_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "acknowledgement"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "outcome": {
          "enum": [
            "applied",
            "refused",
            "duplicate"
          ]
        },
        "reason_code": {
          "enum": [
            "digest_mismatch",
            "unknown_item",
            "revoked_device",
            "not_granted",
            "invalid_record",
            "favorite_with_delete",
            "archive_failed",
            "admission_refused",
            "summary_changed",
            "action_unavailable",
            "prepare_required"
          ]
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review_evidence_id": {
              "type": "string",
              "maxLength": 128
            },
            "archived": {
              "type": "boolean"
            },
            "job_ids": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "action_summary": {
              "$ref": "#/$defs/action_summary"
            },
            "detail": {
              "description": "Why an action could not be prepared or admitted, as a closed code (never compiler text, which can name paths).",
              "enum": [
                "not_an_image",
                "source_changed",
                "provenance_unverified",
                "recipe_not_variable",
                "model_unavailable",
                "model_family_refused",
                "adetailer_unavailable",
                "detector_unavailable",
                "operation_unsupported",
                "app_busy",
                "app_shutting_down",
                "compile_failed"
              ]
            }
          }
        },
        "acknowledged_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "refused"
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    },
    "immich_receipt": {
      "description": "Gateway to PC (listed with the outbox): the result of uploading a kept item to Immich (D3). Idempotent by Immich checksum.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "record_id",
        "item",
        "status",
        "at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "immich_receipt"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "item": {
          "$ref": "#/$defs/item_ref"
        },
        "status": {
          "enum": [
            "uploaded",
            "duplicate",
            "failed"
          ]
        },
        "immich_asset_id": {
          "type": "string",
          "maxLength": 64
        },
        "album": {
          "type": "string",
          "maxLength": 200
        },
        "favorite": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string",
          "maxLength": 64
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "device_revocation": {
      "description": "PC to gateway: revoke a device enrolled from this desktop (S11). The gateway can also revoke locally.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "device_id",
        "revoked_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "device_revocation"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "pairing_offer": {
      "description": "PC to gateway: a single-use phone enrollment offer (D5, S1). The desktop shows the code; only its salted hash is sent. The gateway enforces expiry and an attempt cap, then reports the enrolled device id in the next outbox page's device list or by refusal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "offer_id",
        "code_salt",
        "code_sha256",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "type": {
          "const": "pairing_offer"
        },
        "offer_id": {
          "$ref": "#/$defs/uuid"
        },
        "code_salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "code_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256(code_salt || code) in lowercase hex."
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "review",
              "queue"
            ]
          }
        },
        "device_label": {
          "type": "string",
          "maxLength": 64
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
