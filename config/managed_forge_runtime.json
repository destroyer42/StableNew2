    "model_reference_flag": "--forge-ref-a1111-home",
    "data_dir_flag": "--data-dir",
    "launch_script": "launch.py",
    "env": {
      "GRADIO_ANALYTICS_ENABLED": "False",
      "HF_HUB_OFFLINE": "1",
      "TRANSFORMERS_OFFLINE": "1",
      "YOLO_AUTOINSTALL": "False",
      "YOLO_OFFLINE": "True",
      "PYTHONIOENCODING": "utf-8",
      "PYTHONUNBUFFERED": "1",
      "STABLENEW_WEBUI_NEW_CONSOLE": "0"
    }
  },
  "runtime_dirs": {
    "data": "data",
    "detectors": "data/models/adetailer",
    "extensions": "data/extensions",
    "huggingface_cache": "runtime/hf/hub",
    "matplotlib": "runtime/matplotlib",
    "yolo_config": "runtime/yolo",
    "uv_cache": "runtime/uv-cache"
  },
  "config": {
    "file": "data/config.json",
    "required_settings": {
      "disabled_extensions": [],
      "ad_extra_models_dir": ""
    }
  },
  "extensions": {
