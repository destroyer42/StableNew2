    "marker": ".stablenew-managed-forge.json",
    "path_budget": {
      "max_venv_relative_path": 192,
      "windows_path_limit": 259,
      "note": "Longest path below venv in the accepted package set (torch's licenses tree). Windows long paths are off by default, so the venv prefix must leave this much room or pip fails deep into the install."
